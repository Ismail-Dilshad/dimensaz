# Shell environment variables supported by the toolkit.
# .env files are not loaded automatically. Use config/*.json for design defaults.
# VIDEO_WORKSPACE=./workspace
# VIDEO_OUTPUT=./mp2
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
# CHROMIUM_PATH=C:/path/to/chrome-headless-shell.exe
# VIDEO_PYTHON=./.venv/Scripts/python.exe
# VIDEO_LATIN_FONT=C:/Windows/Fonts/arial.ttf
# No external AI API key is used by the renderer.

# Persistent speech weights; default stays on the project drive. No automatic cache deletion.
# VIDEO_MODEL_DIR=D:/kurdish-text-animation-video/workspace/cache/audio-models
