# Optional environment variables. Copy to .env and edit; .env is never committed.
# .env is not loaded automatically by every command. `reelwright init` writes one for you.
# Design defaults live in config/*.json and brand/profile.json, not here.

# Where jobs and exports are written (relative to the project root).
# VIDEO_WORKSPACE=./workspace
# VIDEO_OUTPUT=./mp2

# Use your own FFmpeg / FFprobe / Chromium instead of the bundled ones.
# FFMPEG_PATH=/path/to/ffmpeg
# FFPROBE_PATH=/path/to/ffprobe
# CHROMIUM_PATH=/path/to/chrome-headless-shell

# Python for the optional audio pipeline (Windows: ./.venv/Scripts/python.exe).
# VIDEO_PYTHON=./.venv/bin/python

# Extra Latin fallback font for missing glyphs (defaults to the bundled open font).
# VIDEO_LATIN_FONT=/path/to/font.ttf

# Where speech models are cached. Models are downloaded only after you confirm.
# VIDEO_MODEL_DIR=./workspace/cache/audio-models

# Optional provider keys. Reelwright renders without any of them.
# ELEVENLABS_API_KEY=
