# Reelwright settings. Copy to .env (or run `pnpm reelwright init`) and uncomment what
# you need. Every value is optional. .env is never committed.
# Commands load .env automatically; real environment variables win over it.
# Design choices (language, colors, logo, fonts, automatic motion) live in
# config/defaults.json and config/brand.json, not here.

# --- Folders (relative to the project root) ---
# VIDEO_WORKSPACE=./workspace     # jobs, projects, caches, history
# VIDEO_OUTPUT=./mp2              # finished exports

# --- Tools (leave unset to use the bundled FFmpeg/FFprobe and Playwright Chromium) ---
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
# CHROMIUM_PATH=C:/path/to/chrome-headless-shell.exe

# --- Optional local speech alignment (Sorani) ---
# VIDEO_PYTHON=./.venv/Scripts/python.exe   # Windows; macOS/Linux: ./.venv/bin/python
# VIDEO_MODEL_DIR=./workspace/cache/audio-models
# VIDEO_MEDIA_MODEL_DIR=./workspace/cache/media-models

# --- Typography ---
# Extra Latin fallback font for Latin words inside other scripts (default: bundled open font)
# VIDEO_LATIN_FONT=./assets/fonts/open/Inter-Variable.ttf

# --- Optional provider keys (Reelwright renders without any of them) ---
# ELEVENLABS_API_KEY=     # word-timed transcripts, captions and pause/filler removal (uploads audio)
# ELEVENLABS_STT_MODEL=scribe_v2
# IMAGE_API_KEY=          # image generation for isolated assets, if your tools use one
