{
  "name": "dimensaz",
  "version": "5.7.0",
  "license": "Apache-2.0",
  "description": "Open-source AI agent for motion graphics and video editing. English by default, multilingual and right-to-left aware.",
  "private": true,
  "type": "module",
  "keywords": [
    "motion-graphics",
    "video-editing",
    "ai-agent",
    "agent-skills",
    "multilingual",
    "rtl",
    "rtl",
    "ffmpeg",
    "playwright",
    "claude-code",
    "codex"
  ],
  "homepage": "https://github.com/Ismail-Dilshad/dimensaz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ismail-Dilshad/dimensaz.git"
  },
  "bugs": {
    "url": "https://github.com/Ismail-Dilshad/dimensaz/issues"
  },
  "bin": {
    "dimensaz": "bin/dimensaz.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "bin/",
    "agent/",
    "src/",
    "audio_pipeline/",
    "media_tools/",
    "config/",
    "assets/fonts/",
    "assets/brand/",
    "skills/",
    "scripts/",
    "SKILL.md",
    "AGENTS.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dimensaz": "node bin/dimensaz.mjs",
    "video:theme": "node scripts/run-checks.mjs --import tsx src/cli/explainer-tools.ts theme",
    "video:duplicates": "node scripts/run-checks.mjs --import tsx src/cli/explainer-tools.ts duplicates",
    "video:frame-qa": "node scripts/run-checks.mjs --import tsx src/cli/explainer-tools.ts frame-qa",
    "video:critic": "node scripts/run-checks.mjs --import tsx src/cli/explainer-tools.ts critic",
    "video:new": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts new",
    "video:import": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts import",
    "video:plan": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts plan",
    "video:preview": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts preview",
    "video:render": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts render",
    "video:validate": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts validate",
    "video:export": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts export",
    "video:list": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts list",
    "video:show": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts show",
    "video:revise": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts revise",
    "video:script": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts script",
    "video:cleanup": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts cleanup",
    "video:doctor": "node scripts/run-checks.mjs --import tsx src/cli/cli.ts doctor",
    "typecheck": "node scripts/run-checks.mjs node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/run-checks.mjs node_modules/vitest/vitest.mjs run",
    "test:e2e": "node scripts/run-checks.mjs --import tsx scripts/smoke.ts",
    "references:update": "node scripts/run-checks.mjs --import tsx src/cli/references-cli.ts update",
    "references:search": "node scripts/run-checks.mjs --import tsx src/cli/references-cli.ts search",
    "references:show": "node scripts/run-checks.mjs --import tsx src/cli/references-cli.ts show",
    "references:annotate": "node scripts/run-checks.mjs --import tsx src/cli/references-cli.ts annotate",
    "references:clip": "node scripts/run-checks.mjs --import tsx src/cli/references-cli.ts clip",
    "references:status": "node scripts/run-checks.mjs --import tsx src/cli/references-cli.ts status",
    "references:source": "node scripts/run-checks.mjs --import tsx src/cli/references-cli.ts source",
    "video:brief": "node scripts/run-checks.mjs --import tsx src/cli/conversation-cli.ts brief",
    "video:answer": "node scripts/run-checks.mjs --import tsx src/cli/conversation-cli.ts answer",
    "video:prepare": "node scripts/run-checks.mjs --import tsx src/cli/conversation-cli.ts prepare",
    "video:finish": "node scripts/run-checks.mjs --import tsx src/cli/conversation-cli.ts finish",
    "video:align": "node scripts/run-checks.mjs --import tsx src/cli/align-voice.ts",
    "audio:doctor": "node scripts/run-checks.mjs --import tsx src/cli/audio-cli.ts doctor",
    "audio:analyze": "node scripts/run-checks.mjs --import tsx src/cli/audio-cli.ts analyze",
    "audio:correct": "node scripts/run-checks.mjs --import tsx src/cli/audio-cli.ts correct",
    "audio:apply": "node scripts/run-checks.mjs --import tsx src/cli/audio-cli.ts apply",
    "test:audio": "node scripts/test-audio.mjs",
    "test:production": "node scripts/run-checks.mjs --import tsx scripts/production-smoke.ts",
    "video:create": "node scripts/run-checks.mjs --import tsx src/cli/create-video.ts",
    "sfx:index": "node scripts/run-checks.mjs --import tsx src/cli/sfx-index.ts",
    "video:benchmark": "node scripts/run-checks.mjs --import tsx scripts/benchmark.ts",
    "assets:library": "node scripts/run-checks.mjs --import tsx src/cli/assets-cli.ts",
    "fonts:library": "node scripts/run-checks.mjs --import tsx src/cli/fonts-cli.ts",
    "sfx:acquire": "node scripts/run-checks.mjs --import tsx src/cli/sfx-acquire.ts",
    "audio:setup": "node scripts/run-checks.mjs --import tsx src/cli/audio-cli.ts setup",
    "audio:benchmark": "node scripts/run-checks.mjs --import tsx src/cli/audio-cli.ts benchmark",
    "audio:precision-probe": "node scripts/run-checks.mjs --import tsx src/cli/audio-cli.ts precision-probe",
    "audio:evaluate": "node scripts/run-checks.mjs --import tsx src/cli/audio-cli.ts evaluate",
    "video:profile": "node scripts/run-checks.mjs --import tsx scripts/render-profile.ts",
    "video:performance": "node scripts/run-checks.mjs --import tsx scripts/render-performance-benchmark.ts",
    "video:interpolate": "node scripts/run-checks.mjs --import tsx src/cli/interpolate-footage.ts",
    "video:clean-tests": "node scripts/run-checks.mjs --import tsx scripts/clean-test-videos.ts",
    "video:style": "node scripts/run-checks.mjs --import tsx src/cli/style-director-cli.ts",
    "video:reference": "node scripts/run-checks.mjs --import tsx src/cli/reference-motion-cli.ts",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "video:edit": "node scripts/run-checks.mjs --import tsx src/editor/cli.ts",
    "knowledge": "node scripts/run-checks.mjs --import tsx src/cli/knowledge-cli.ts",
    "tools": "node scripts/run-checks.mjs --import tsx src/cli/tools-cli.ts",
    "init": "node scripts/run-checks.mjs --import tsx src/cli/init.ts",
    "media": "node scripts/run-checks.mjs --import tsx src/cli/media-cli.ts",
    "reach:doctor": "node scripts/run-checks.mjs --import tsx src/cli/reach-cli.ts doctor",
    "source:doctor": "node scripts/run-checks.mjs --import tsx src/cli/source-cli.ts doctor",
    "media:setup": "node scripts/run-checks.mjs --import tsx src/cli/media-cli.ts setup",
    "media:doctor": "node scripts/run-checks.mjs --import tsx src/cli/media-cli.ts doctor",
    "media:download": "node scripts/run-checks.mjs --import tsx src/cli/media-cli.ts download",
    "test:media": "node scripts/test-media.mjs",
    "example:hello": "node scripts/run-checks.mjs --import tsx examples/run-hello.ts"
  },
  "dependencies": {
    "@jackwener/opencli": "2.0.2",
    "esbuild": "^0.25.0",
    "fflate": "0.8.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lottie-web": "5.13.0",
    "playwright": "^1.56.0",
    "three": "0.180.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.180.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
